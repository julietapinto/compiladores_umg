EZEQUIELAQUIINICIA() [

    int a = 10;
    float b = 2.5;
    string s = "hola";

    int arr[3];

    arr[0] = 1;
    arr[1] = 2;
    arr[2] = 3;

    IMPRIMIR(a);
    IMPRIMIR(arr[1]);

    int x = 5;

    int r = x > 0 ? x : -x;

    IMPRIMIR(r);

    int i = 0;

    MIENTRAS [CON i < 3] [

        CHI_LO_HACE (CON i == 1) [
            BREAK;
        ]

        IMPRIMIR(i);
        i = i + 1;
    ]

    SWITCH (x) [
        CASE 1:
            IMPRIMIR(x);
        CASE 5:
            IMPRIMIR(x);
        DEFAULT:
            IMPRIMIR(0);
    ]

]

EZEQUIELAQUIFINALIZA()